# Copier en .env sur la tour et adapter.

# Adresse et port de l'hôte où publier le site.
# 0.0.0.0 = toutes les interfaces : réseau local + VPN (Tailscale/WireGuard sur l'hôte).
# Ne pas rediriger ce port sur la box : le site ne doit pas être exposé sur Internet.
HAMEAUX_HOST_BIND=0.0.0.0
HAMEAUX_HOST_PORT=8080

# Secondes de jeu par seconde réelle (60 = 1 jour de jeu en 24 min).
HAMEAUX_SPEED=60

# Nouveau monde (ignoré si une sauvegarde existe) : graine (vide = aléatoire),
# côté de la carte en cases, nombre de villages.
HAMEAUX_SEED=
HAMEAUX_MAP_SIZE=1024
HAMEAUX_VILLAGES=12

# Sauvegarde automatique toutes les N secondes, nombre de sauvegardes gardées.
HAMEAUX_SAVE_EVERY=300
HAMEAUX_KEEP_SAVES=48
HAMEAUX_KEEP_DAILY=30

RUST_LOG=info

# Utilisateur et groupe propriétaires de ./data (ajoutés par deploy.sh au premier déploiement).
# HAMEAUX_UID=1000
# HAMEAUX_GID=1000
